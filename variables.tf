variable "prefix" {
  description = "Prefix for all resource names"
  type        = string
  default     = "learningsteps"
}

variable "location" {
  description = "Azure region"
  type        = string
  default     = "westeurope"
}

variable "vm_size" {
  description = "VM size. Standard_D2s_v3 often hits SkuNotAvailable (capacity) in westeurope; v6 sizes use the NVMe disk controller automatically (see vm.tf)."
  type        = string
  default     = "Standard_D2s_v6"
}

variable "vm_admin_username" {
  description = "Admin username for the VM"
  type        = string
  default     = "azureuser"
}

variable "vm_admin_ssh_key" {
  description = "SSH public key for VM access"
  type        = string
}

variable "db_admin_username" {
  description = "Administrator username for PostgreSQL"
  type        = string
  default     = "psqladmin"
}

variable "db_admin_password" {
  description = "Administrator password for PostgreSQL"
  type        = string
  sensitive   = true
}

variable "db_app_username" {
  description = "Least-privilege PostgreSQL role the app connects as (F-10). Created on the VM by scripts/setup-db-secrets.sh; its password is generated by Terraform and stored in Key Vault."
  type        = string
  default     = "learningsteps_app"
}

variable "db_name" {
  description = "Name of the application database"
  type        = string
  default     = "learning_journal"
}

variable "admin_source_ip" {
  description = "Public IPv4 address (or CIDR) allowed to reach SSH (22). Day 1 hardening: never \"*\"."
  type        = string

  validation {
    condition     = can(cidrhost(strcontains(var.admin_source_ip, "/") ? var.admin_source_ip : "${var.admin_source_ip}/32", 0)) && !strcontains(var.admin_source_ip, ":")
    error_message = "admin_source_ip must be an IPv4 address or IPv4 CIDR (e.g. 203.0.113.10 or 203.0.113.0/24). \"*\" and IPv6 are not allowed."
  }
}

variable "network_watcher_name" {
  description = "Existing Network Watcher in the deployment region. Azure creates it automatically as NetworkWatcher_<location> in NetworkWatcherRG; null means that default."
  type        = string
  default     = null
}

variable "network_watcher_resource_group" {
  description = "Resource group of the Network Watcher (Azure's default is NetworkWatcherRG)."
  type        = string
  default     = "NetworkWatcherRG"
}

variable "flow_log_retention_days" {
  description = "How long raw VNet flow logs are kept in the storage account. Traffic Analytics data in Log Analytics follows the workspace retention (30 days)."
  type        = number
  default     = 7
}
